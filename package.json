{
  "name": "umodel-mcp",
  "version": "0.3.0",
  "description": "MCP server wrapping umodel (UE Viewer) for extracting/exporting Unreal Engine assets",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CHA1007/Umodel-MCP.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "umodel",
    "unreal-engine",
    "ue4",
    "game-assets",
    "pak"
  ],
  "type": "module",
  "bin": {
    "umodel-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "tsx --test src/pak.test.ts src/session.test.ts src/tree.test.ts src/umodel.test.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
